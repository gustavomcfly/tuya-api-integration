{
  "name": "tuya-rd-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca tsx watch server.ts",
    "start": "cross-env NODE_OPTIONS=--use-system-ca tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tuya/*.test.ts",
    "tuya:check": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tuya-check.ts",
    "mock:tuya": "tsx scripts/mock-tuya.ts",
    "dev:mock": "cross-env TUYA_BASE_URL=http://localhost:3999 TUYA_ACCESS_ID=mockaccessid0000 TUYA_ACCESS_SECRET=mock-secret-0123456789abcdefghij tsx watch server.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "cross-env": "^7.0.3",
    "prisma": "7.9.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
