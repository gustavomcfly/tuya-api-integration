PORT=3002

# Projeto Cloud da Tuya (platform.tuya.com > Cloud > Development > seu projeto > Overview)
TUYA_ACCESS_ID=seu_access_id
TUYA_ACCESS_SECRET=seu_access_secret
# Data center do projeto: us | us-e | eu | eu-w | cn | in | sg
TUYA_REGION=us
# Opcional: força uma URL base (ex.: proxy/mock)
# TUYA_BASE_URL=https://openapi.tuyaus.com
# Opcional: UID da conta do app vinculada, usado se a listagem por "usuários associados" falhar
# TUYA_APP_UID=
# Opcional: fuso das agendas de senha (padrão: fuso do servidor). Ex.: -03:00
# TUYA_TIME_ZONE=-03:00

# Sessão do sistema
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
# Código exigido para novos cadastros depois do primeiro usuário (vazio = cadastro fechado)
SIGNUP_CODE=

DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/tuya_testlock_db?schema=public"
