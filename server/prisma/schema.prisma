generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. Núcleo e Acessos
// ------------------------------------------------------

// A Tuya autentica o PROJETO cloud (Access ID/Secret), não a pessoa. Por isso o
// sistema tem contas próprias: usuário + senha (hash scrypt).
model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String?
  passwordHash  String
  createdAt     DateTime       @default(now())
  lastLoginAt   DateTime?

  settings      UserSettings?
  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
  reports       Report[]
}

// IDs de dispositivo da Tuya são strings (ex.: "eb3b1c0a7d8f2a1b9ckq1x").
model Device {
  deviceId      String         @id
  name          String
  category      String?
  productName   String?
  createdAt     DateTime       @default(now())

  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
  reports       Report[]
}

// ------------------------------------------------------
// 2. Configurações (uma linha por usuário)
// ------------------------------------------------------

model UserSettings {
  userId            String   @id
  testerName        String?
  stdPasscode       String?
  defaultCycles     Int      @default(100)
  defaultUnlockTime Int      @default(5)
  defaultInterval   Int      @default(5)
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 3. Teste de Ciclagem
// ------------------------------------------------------

model CyclicTest {
  id                     String          @id @default(uuid())
  deviceId               String
  userId                 String?
  totalCycles            Int
  completedCycles        Float           @default(0)
  delayBetweenCycles     Int             @default(5)
  status                 String          // running | paused | completed | failed | stopped
  totalFailures          Int             @default(0)
  maxConsecutiveFailures Int             @default(3)
  lowBatteryThreshold    Int             @default(20)
  battery                Int?
  batteryStart           Int?
  batteryEnd             Int?
  startedAt              DateTime        @default(now())
  completedAt            DateTime?

  device                 Device          @relation(fields: [deviceId], references: [deviceId])
  user                   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  logs                   CyclicTestLog[]
  report                 Report?

  @@index([userId])
  @@index([deviceId])
  @@index([status])
}

model CyclicTestLog {
  id        String     @id @default(uuid())
  testId    String
  type      String     // UNLOCK | LOCK | BATTERY | SYSTEM
  level     String     // info | success | warning | error
  message   String
  timestamp DateTime   @default(now())

  test      CyclicTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

// ------------------------------------------------------
// 4. Auditoria de Qualidade
// ------------------------------------------------------

model QualityAudit {
  id          String             @id @default(uuid())
  deviceId    String
  userId      String?
  status      String             // "executando" | "concluido"
  testerName  String?
  params      Json?
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  device      Device             @relation(fields: [deviceId], references: [deviceId])
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps       QualityAuditStep[]
  report      Report?

  @@index([userId])
  @@index([deviceId])
}

model QualityAuditStep {
  id        String       @id @default(uuid())
  auditId   String
  position  Int
  stepKey   String
  stepName  String
  status    String       // "pendente" | "executando" | "sucesso" | "falha"
  errorMsg  String?
  logs      Json         @default("[]")
  timestamp DateTime     @default(now())

  audit     QualityAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ------------------------------------------------------
// 5. Relatórios Salvos
// ------------------------------------------------------

model Report {
  id             String        @id @default(uuid())
  type           String        // "cyclic" | "quality"
  title          String
  userId         String?
  deviceId       String
  cyclicTestId   String?       @unique
  qualityAuditId String?       @unique
  deviceName     String
  status         String
  testerName     String?
  startedAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  payload        Json

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  device         Device        @relation(fields: [deviceId], references: [deviceId])
  cyclicTest     CyclicTest?   @relation(fields: [cyclicTestId], references: [id], onDelete: SetNull)
  qualityAudit   QualityAudit? @relation(fields: [qualityAuditId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId])
}
